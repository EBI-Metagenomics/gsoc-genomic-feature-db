{
  "name": "genomic-feature-search",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based genomic feature search with an embedded JBrowse linear view",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "index": "python ../scripts/indexer.py ../sample_data/MGYG000490722/MGYG000490722.gff.gz",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@jbrowse/react-linear-genome-view2": "4.3.0",
    "@sqlite.org/sqlite-wasm": "^3.51.2-build6",
    "comlink": "^4.4.1",
    "mobx": "6.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite-wasm-http": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "8.65.0",
    "vite": "^5.4.1",
    "vitest": "2.1.9"
  }
}
