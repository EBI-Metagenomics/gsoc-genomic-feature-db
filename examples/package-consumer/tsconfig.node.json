{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "composite": true
  },
  "include": [
    "dev/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
